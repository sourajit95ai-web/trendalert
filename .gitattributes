# dashboard.html is generated by frontend/build_dashboard.py from frontend/v2/.
# `build_dashboard.py --check` compares the committed artifact against a fresh
# build byte-for-byte, so the source tree and the artifact must not have their
# line endings rewritten per-platform -- otherwise the check passes in CI and
# fails on a Windows checkout (or the reverse).
frontend/dashboard.html       text eol=lf
frontend/v2/**                text eol=lf
frontend/build_dashboard.py   text eol=lf
