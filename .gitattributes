# dashboard-v2.html is generated by frontend/build_v2.py from frontend/v2/.
# `build_v2.py --check` compares the committed artifact against a fresh build
# byte-for-byte, so the source tree and the artifact must not have their line
# endings rewritten per-platform -- otherwise the check passes in CI and fails
# on a Windows checkout (or the reverse).
frontend/dashboard-v2.html  text eol=lf
frontend/v2/**              text eol=lf
frontend/build_v2.py        text eol=lf
